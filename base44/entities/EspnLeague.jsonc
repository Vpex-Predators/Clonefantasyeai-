{
  "name": "EspnLeague",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string",
      "description": "ESPN fantasy league ID"
    },
    "league_name": {
      "type": "string",
      "description": "League display name"
    },
    "season": {
      "type": "integer",
      "description": "NFL season year"
    },
    "espn_s2": {
      "type": "string",
      "description": "ESPN espn_s2 session cookie"
    },
    "swid": {
      "type": "string",
      "description": "ESPN SWID session cookie"
    }
  },
  "required": [
    "league_id",
    "espn_s2",
    "swid"
  ]
}